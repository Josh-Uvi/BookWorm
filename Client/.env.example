# All optional — the defaults work with the Vite dev proxies (vite.config.ts)
# and with the Nginx container used in docker-compose.

# WebSocket server. Empty = same-origin /ws (proxied in dev and in Docker).
VITE_WS_URL=

# Media root (books.json + PDFs). Default: /media (proxied in dev and Docker).
VITE_MEDIA_URL=/media
