# ══════════════════════════════════════════════════════════════════
# AI Reading Assistant — configuration
# Copy to `.env` and adjust:   cp .env.example .env   (also done by `make setup`)
# Every AI provider is swappable here — no code changes required.
# ══════════════════════════════════════════════════════════════════

# ── Server networking ───────────────────────────────────────────
HOST=0.0.0.0
PORT=8765
MEDIA_PORT=8766
SERVE_MEDIA=true

# ── Assistant behaviour ─────────────────────────────────────────
# Seconds of transcript to accumulate before the LLM decides whether the
# child needs help, and how often buffered audio is sent to the STT.
ACCUMULATION_WINDOW_SECONDS=5
STT_FLUSH_INTERVAL=4
MAX_BUFFER_BYTES=20971520

# ── Guardrails: when the assistant is allowed to interrupt ──────────
# Passage-overlap score above which the child is considered to be reading
# aloud (the assistant stays quiet), minimum seconds between help messages
# for non-question intents, and the LLM confidence required to speak up.
READING_MATCH_THRESHOLD=0.5
HELP_COOLDOWN_SECONDS=30
HELP_MIN_CONFIDENCE=0.7

# ── Speech-to-text (open source, offline) ────────────────────────
STT_PROVIDER=faster_whisper
WHISPER_MODEL=base           # tiny | base | small | medium | large-v3
WHISPER_DEVICE=cpu           # cpu | cuda (see docker-compose.gpu.yml)
WHISPER_COMPUTE_TYPE=int8    # int8 (cpu) | float16 (gpu)

# ── Language model (any OpenAI-compatible endpoint) ─────────────
# Native dev:  http://localhost:11434/v1  (local Ollama)
# In Docker, compose overrides this to http://ollama:11434/v1.
# Swap freely — vLLM, LM Studio, Groq, OpenAI — same interface.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
# Recommended: qwen2.5:3b — strong grounded answers + clean JSON, ~2 GB, runs on a
# laptop (needs ~4 GB RAM; Docker Desktop's ~2 GB VM OOM-kills it — see
# LLM_BASE_URL_DOCKER below). Lighter fallbacks: qwen2.5:1.5b (~1 GB),
# llama3.2:1b (~1.3 GB). Avoid qwen3.5:* — hybrid *thinking* models whose
# <think> blocks exhaust the token budget and break JSON output.
LLM_MODEL=qwen2.5:3b
# Docker-compose only (native dev uses LLM_BASE_URL above): point the server
# container at the host's native Ollama when the Docker VM is too small for
# the configured model, e.g. http://host.docker.internal:11434/v1
# LLM_BASE_URL_DOCKER=http://host.docker.internal:11434/v1
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=500
LLM_TIMEOUT=30

# ── Text-to-speech ──────────────────────────────────────────────
TTS_PROVIDER=piper            # piper (offline, default — replaces Amazon Polly) | edge_tts (online)
TTS_VOICE=en-GB-SoniaNeural   # edge-tts voice id; used only when TTS_PROVIDER=edge_tts
PIPER_VOICE=en_US-amy-medium  # piper voice; baked into the Docker image & fetched by `make setup`
# Friendly voice options for a child audience:
#   piper (offline):   en_US-amy-medium (default, warm) · en_US-lessac-medium · en_GB-alan-low
#                      — browse https://huggingface.co/rhasspy/piper-voices
#   edge-tts (online): en-US-AnaNeural (child voice!) · en-GB-SoniaNeural (teacher-like)
#                      — set TTS_VOICE accordingly when TTS_PROVIDER=edge_tts
PIPER_MODELS_DIR=models       # native path; compose mounts /app/models

# ── Book/media storage ──────────────────────────────────────────
STORAGE_PROVIDER=local        # local | minio (S3-compatible)
MEDIA_DIR=media
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=books
# MINIO_SECURE=false

# ── Client build (Vite) ────────────────────────────────────────
# Both default to same-origin paths; the Vite dev server and the Nginx
# container proxy them, so nothing needs changing for local or Docker.
VITE_WS_URL=
VITE_MEDIA_URL=/media

# ── Docker compose extras ──────────────────────────────────────
OLLAMA_MODEL=qwen2.5:3b     # pulled by `make setup` (keeps native + container Ollama in sync with LLM_MODEL)
