# ══════════════════════════════════════════════════════════════════
# AI Reading Assistant — configuration
# Copy to `.env` and adjust:   cp .env.example .env   (also done by `make setup`)
# Every AI provider is swappable here — no code changes required.
# ══════════════════════════════════════════════════════════════════

# ── Server networking ───────────────────────────────────────────
HOST=0.0.0.0
PORT=8765
MEDIA_PORT=8766
SERVE_MEDIA=true

# ── Assistant behaviour ─────────────────────────────────────────
# Seconds of transcript to accumulate before the LLM decides whether the
# child needs help, and how often buffered audio is sent to the STT.
ACCUMULATION_WINDOW_SECONDS=5
STT_FLUSH_INTERVAL=4
MAX_BUFFER_BYTES=20971520

# ── Speech-to-text (open source, offline) ────────────────────────
STT_PROVIDER=faster_whisper
WHISPER_MODEL=base           # tiny | base | small | medium | large-v3
WHISPER_DEVICE=cpu           # cpu | cuda (see docker-compose.gpu.yml)
WHISPER_COMPUTE_TYPE=int8    # int8 (cpu) | float16 (gpu)

# ── Language model (any OpenAI-compatible endpoint) ─────────────
# Native dev:  http://localhost:11434/v1  (local Ollama)
# In Docker, compose overrides this to http://ollama:11434/v1.
# Swap freely — vLLM, LM Studio, Groq, OpenAI — same interface.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2:1b         # lightweight 1B default (~1.3 GB); qwen2.5:0.5b for tiny VMs
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=500
LLM_TIMEOUT=30

# ── Text-to-speech ──────────────────────────────────────────────
TTS_PROVIDER=piper            # piper (offline, default — replaces Amazon Polly) | edge_tts (online)
TTS_VOICE=en-GB-SoniaNeural   # edge-tts voice id; used only when TTS_PROVIDER=edge_tts
PIPER_VOICE=en_US-amy-medium  # piper voice; baked into the Docker image & fetched by `make setup`
PIPER_MODELS_DIR=models       # native path; compose mounts /app/models

# ── Book/media storage ──────────────────────────────────────────
STORAGE_PROVIDER=local        # local | minio (S3-compatible)
MEDIA_DIR=media
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=books
# MINIO_SECURE=false

# ── Client build (Vite) ────────────────────────────────────────
# Both default to same-origin paths; the Vite dev server and the Nginx
# container proxy them, so nothing needs changing for local or Docker.
VITE_WS_URL=
VITE_MEDIA_URL=/media

# ── Docker compose extras ──────────────────────────────────────
OLLAMA_MODEL=llama3.2:1b     # pulled by `make setup` (lightweight 1B default)
